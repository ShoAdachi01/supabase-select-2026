# Local Supabase: python3 scripts/local_env.py
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Set only if the browser uses a different Supabase address than the worker.
# SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
# Optional: broader live reverse-image discovery. Enable Cloud Vision and billing.
GOOGLE_VISION_API_KEY=
# Optional: Google Lens through SerpAPI; requires a public reference-image URL.
SERPAPI_API_KEY=
# Optional, explicitly enabled per scan: compare different depictions with Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Explicit shared offline fallback. Keep false when using Supabase.
LOCAL_DEMO_MODE=false
TRACE_DATA_DIR=.trace
