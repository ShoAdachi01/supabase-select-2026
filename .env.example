# Populate automatically for the local stack with: python3 scripts/local_env.py
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Optional if the API worker reaches Supabase at a different URL than the browser.
# SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
# Optional: natural-language task planning. No key is needed for ML training.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Explicit offline fallback; leave false when using Supabase.
LOCAL_DEMO_MODE=false
FORGE_DATA_DIR=.forge
