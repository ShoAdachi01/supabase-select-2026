# Local Supabase: python3 scripts/local_env.py
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
# Set only if the browser uses a different Supabase address than the worker.
# SUPABASE_PUBLIC_URL=http://127.0.0.1:54321
# Optional: broader live reverse-image discovery. Enable Cloud Vision and billing.
GOOGLE_VISION_API_KEY=
# Optional: Google Lens through SerpAPI; requires a public reference-image URL.
SERPAPI_API_KEY=
# Optional, explicitly enabled per scan: compare different depictions with Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Explicit shared offline fallback. Keep false when using Supabase.
LOCAL_DEMO_MODE=false
TRACE_DATA_DIR=.trace
# Cutroom: browser director and generated narration.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: use Claude API credits for the browser director.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
ANTHROPIC_WORKSPACE_ID=
# auto uses OpenAI, or Claude when its workspace ID is configured.
CUTROOM_DIRECTOR=auto
# Optional generated launch visuals; requires a paid video-generation quota.
VEO_MODEL=veo-3.1-fast-generate-preview
SORA_MODEL=sora-2
# Optional: upload a sample to create a reusable custom narrator.
ELEVENLABS_API_KEY=
CUTROOM_DATA_DIR=.cutroom
# Server-owned sample app; set this to the deployed origin when hosting.
CUTROOM_SAMPLE_ORIGIN=http://127.0.0.1:8000
# Optional canonical origin for links returned to remote agents.
CUTROOM_PUBLIC_ORIGIN=
# Vercel only: public HTTPS origin of the separately deployed persistent worker.
# Set in the Vercel project environment and redeploy after changing it.
CUTROOM_WORKER_ORIGIN=
# Use a long random value to keep preview signatures stable across restarts.
CUTROOM_SIGNING_KEY=
